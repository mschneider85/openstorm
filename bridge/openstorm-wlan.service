[Unit]
Description=OpenStorm WLAN (bekanntes WLAN oder eigenes WLAN zum Einrichten)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/openstorm/wlan-setup.sh
RemainAfterExit=yes
# Up to a few minutes when the own network needs several attempts.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
