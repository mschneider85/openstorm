[Unit]
Description=OpenStorm-Bruecke (App <-> EV3)
After=bluetooth.service network.target
Wants=bluetooth.service

[Service]
ExecStartPre=-/usr/sbin/rfkill unblock all
ExecStart=/usr/bin/python3 /opt/openstorm/openstorm_bridge.py
Environment=PYTHONUNBUFFERED=1
StateDirectory=openstorm
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
