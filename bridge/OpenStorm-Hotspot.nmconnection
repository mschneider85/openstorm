[connection]
id=OpenStorm-Hotspot
type=wifi
# Opened by wlan-setup.sh (or the bridge) only when no known network is in range.
autoconnect=false

[wifi]
mode=ap
ssid=OpenStorm
band=bg
# The Pi Zero W's chip (brcmfmac) cannot open its network on every channel
# (NetworkManager picked 13 and failed); 6 works everywhere.
channel=6
# Open, without a password: the chip turned devices away during the WPA handshake
# ("wrong password"), and the network only serves the setup page anyway.

[ipv4]
method=shared
address1=10.42.0.1/24

[ipv6]
method=ignore
