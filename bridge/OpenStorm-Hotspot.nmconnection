[connection]
id=OpenStorm-Hotspot
type=wifi
# Opened by wlan-setup.sh (or the bridge) only when no known network is in range.
autoconnect=false

[wifi]
mode=ap
ssid=OpenStorm
band=bg

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
psk=openstorm

[ipv4]
method=shared
address1=10.42.0.1/24

[ipv6]
method=ignore
